<?xml version="1.0" encoding="utf-8"?>
<!-- Aperçu du sélecteur de widgets (Android 12+), aux couleurs dynamiques du système. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/widget_preview_circle"
        android:gravity="center"
        android:text="@string/widget_preview_emoji"
        android:textSize="32sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_preview_label"
        android:textColor="@color/widget_preview_text"
        android:textSize="13sp" />
</LinearLayout>
