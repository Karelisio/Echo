    <!-- Guide Honor / MagicOS -->
    <string name="guide_title">Mon téléphone ne vibre pas</string>
    <string name="guide_subtitle">Réglages à vérifier, surtout sur Honor et Huawei</string>
    <string name="guide_subtitle_recommended">Recommandé sur ton téléphone Honor / Huawei</string>
    <string name="guide_intro">MagicOS (Honor) et EMUI (Huawei) peuvent bloquer Écho en arrière-plan ou pendant Ne pas déranger. Vérifie ces quatre points :</string>
    <string name="guide_step_launch_title">1. Lancement des applications</string>
    <string name="guide_step_launch_text">Paramètres → Batterie → Lancement d’applications → Écho : désactive la gestion automatique, puis active « Lancement automatique », « Lancement secondaire » et « Exécution en arrière-plan ».</string>
    <string name="guide_step_dnd_title">2. Exceptions de Ne pas déranger</string>
    <string name="guide_step_dnd_text">Paramètres → Sons et vibrations → Ne pas déranger → Exceptions (ou « Autoriser les interruptions ») → Applications : ajoute Écho. Laisse aussi les alarmes autorisées.</string>
    <string name="guide_step_channel_title">3. Canal « Échos reçus »</string>
    <string name="guide_step_channel_text">Dans les notifications d’Écho, ouvre « Échos reçus » et active « Ignorer Ne pas déranger » (parfois appelé « Prioritaire »).</string>
    <string name="guide_step_lock_title">4. Verrouiller Écho dans les applis récentes</string>
    <string name="guide_step_lock_text">Ouvre les applis récentes et fais glisser la vignette d’Écho vers le bas pour afficher le cadenas : le nettoyage automatique ne la fermera plus.</string>
    <string name="guide_retest">Refais ensuite un écho de test « Dans 10 s », écran verrouillé.</string>
</resources>
